# Copy this file to .env and fill in real values. .env is never committed.

# Local dev: run `npx prisma dev` in a separate terminal, then use the URL
# it prints (defaults to the one below). For staging/production, this
# points at a hosted Postgres instance (e.g. Neon or Supabase) instead —
# see docs/PLANNING.md §3.
#
# connection_limit=1 is required against the local `prisma dev` proxy, not
# optional: with the default pool size, concurrent queries (e.g. a page
# firing 2-3 tRPC queries at once, which tRPC batches into one request)
# corrupt the proxy's prepared-statement protocol — "bind message supplies
# N parameters, but prepared statement requires 0". Real Postgres doesn't
# have this problem; drop the param once DATABASE_URL points at a real
# hosted instance instead of the local proxy.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"

# Auth.js — required even with zero providers configured. Generate your own
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Auth.js providers — sign-in has nothing to show until these are set.
# Google: create an OAuth app at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend (magic-link email): get an API key at https://resend.com
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM=""

# Web Push (daily reminder, PRD §7) — no account needed, unlike Resend
# above. Generate your own pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

