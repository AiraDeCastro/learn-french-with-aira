# Copy this file to .env and fill in real values. .env is never committed.

# As of 2026-09-19, local dev points at a real hosted Neon Postgres
# instance (see docs/PLANNING.md §3 and the CLAUDE.md session summary for
# that date) — get the connection string from your Neon project's
# dashboard (Connect / Connection Details). This replaced the local
# `npx prisma dev` proxy, which was a chronic source of
# "Connection terminated unexpectedly" flakiness throughout this project's
# early sessions (see CLAUDE.md's "Commit workflow" section) — real
# Postgres doesn't have that problem, so `connection_limit=1` (needed only
# to work around the local proxy's prepared-statement bug) is no longer
# needed either.
#
# Falling back to the local proxy still works with no account needed: run
# `npx prisma dev` in a separate terminal and use the URL it prints
# (defaults to the one below) — just re-add `&connection_limit=1` to it,
# and expect the flakiness documented in CLAUDE.md.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Auth.js — required even with zero providers configured. Generate your own
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Auth.js providers — sign-in has nothing to show until these are set.
# Google: create an OAuth app at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend (magic-link email): get an API key at https://resend.com
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM=""

# Web Push (daily reminder, PRD §7) — no account needed, unlike Resend
# above. Generate your own pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

