    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "audit:check": "node scripts/check-audit.mjs",
    "deps:check": "npm ls",
    "verify": "npm run format:check && npm run lint && npm run deps:check && npm run audit:check && npm run db:generate && npm run db:push && npm run db:seed && npm run typecheck && npm run test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.102.8",
